name = "OLED Dark"
author = "Schema Spelunker"

# OLED theme — every surface is pure black (pixels off). No near-black greys:
# popups, cards, controls and title bars are all #000000. Separation comes
# from the other channels instead:
#   - borders/outlines (slightly brighter than the paper themes, they now do
#     all the separating work)
#   - grid lines, scrollbar grab
#   - dim grey text (no pure white)
#   - accent (buttons, checkmarks, headers, diagram links/pins are
#     accent-tinted; hover/selected feedback on buttons and rows is accent
#     alpha, which survives on black)
# backdrop is "none" on purpose — Mica would fog the black with a desktop
# tint and waste the OLED black state.

[text]
main = "#C8C8C8"
muted = "#707070"

[background]
window = "#000000"
child = "#000000"
popup = "#000000"

[controls]
frame = "#000000"
frame_hover = "#000000"
frame_active = "#000000"

[title_bar]
background = "#000000"
background_focus = "#000000"
background_faded = "#000000"

[table_card]
background = "#000000"
background_hovered = "#000000"
background_selected = "#000000"
outline = "#3A3A3A"

[border]
main = "#3A3A3A"
subtle = "#262626"

[diagram_grid]
background = "#000000"
line = "#2E2E2E"

[diagram_links]
colour = "#6BAEFF"
thickness = 2.0

[accent]
colour = "#4B7BA5"

[glass]
backdrop = "none"
backdrop_alpha = 1.0
popup_alpha = 1.0

[layout]
corner_rounding = 2
scrollbar_size = 14
grab_min_size = 12
item_spacing = horizontal: 8, vertical: 6
item_inner_spacing = horizontal: 6, vertical: 4
window_padding = horizontal: 12, vertical: 12
frame_padding = horizontal: 6, vertical: 4
cell_padding = horizontal: 6, vertical: 4
border_width = 1
frame_border_width = 1
tab_border_width = 1
